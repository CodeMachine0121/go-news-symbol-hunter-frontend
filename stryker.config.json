{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "mutate": [
    "app/domain/**/*.ts",
    "!app/domain/interface/**",
    "app/application/**/*.ts",
    "app/infrastructure/**/*.ts",
    "app/composables/**/*.ts"
  ],
  "reporters": [
    "clear-text",
    "json"
  ],
  "coverageAnalysis": "perTest",
  "concurrency": 6,
  "tempDirName": ".stryker-tmp",
  "ignorePatterns": [
    "!.nuxt",
    ".output",
    "coverage"
  ]
}